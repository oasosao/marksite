{
  "name": "marksite-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prepare-vditor": "node -e \"const fs=require('fs');fs.rmSync('public/vditor',{recursive:true,force:true});fs.mkdirSync('public/vditor',{recursive:true});fs.cpSync('node_modules/vditor/dist','public/vditor/dist',{recursive:true});\""
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "axios": "^1.13.0",
    "element-plus": "^2.11.0",
    "vditor": "^3.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
